<Window x:Class="Virgil.App.AlphaWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Virgil.App"
        Title="Virgil 2.0 — Avertissement alpha"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource App.BackgroundBrush}"
        Foreground="{DynamicResource App.TextPrimaryBrush}" FontFamily="Segoe UI">
    <Border Margin="18" Style="{StaticResource VirgilHudPanel}">
        <StackPanel>
            <TextBlock Text="{x:Static local:AlphaWarningWindow.WarningText}"
                       TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20" />
            <Button Content="OK" IsDefault="True" IsCancel="True" Click="Accept_Click"
                    HorizontalAlignment="Right" MinWidth="90"
                    Style="{StaticResource VirgilPrimaryButton}" />
        </StackPanel>
    </Border>
</Window>
