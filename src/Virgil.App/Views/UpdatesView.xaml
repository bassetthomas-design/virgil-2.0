<UserControl x:Class="Virgil.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Virgil.App.ViewModels"
             xmlns:controls="clr-namespace:Virgil.App.Controls"
             MinWidth="0"
             MinHeight="0"
             KeyboardNavigation.TabNavigation="Continue"
             FocusManager.IsFocusScope="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate DataType="{x:Type vm:UpdateItemViewModel}">
            <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsSelectable}" Margin="0,0,0,8"
                              Foreground="{DynamicResource App.TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource VirgilHudSecondaryText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdateTextCardViewModel}">
            <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Text}" Style="{StaticResource VirgilHudSecondaryText}"
                           TextWrapping="Wrap" Margin="0,3,0,0" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="UpdatesTextCardTemplate">
            <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                <TextBlock Text="{Binding}" Style="{StaticResource VirgilHudSecondaryText}"
                           TextWrapping="Wrap" Margin="0,3,0,0" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      ClipToBounds="True">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl x:Name="UpdatesMiniCore"
                                                Width="72"
                                                Height="72"
                                                AnimationDetailLevel="Compact"
                                                AutomationProperties.Name="Mini noyau Virgil mises a jour" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MISES A JOUR V1"
                                   Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="UpdatesStatusText"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <WrapPanel KeyboardNavigation.TabNavigation="Continue">
                    <Button x:Name="ScanUpdatesButton" IsEnabled="{Binding IsIdle}"
                            Content="SCANNER LES MISES A JOUR"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="190"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Scanner les mises a jour"
                            Command="{Binding ScanUpdatesCommand}" />
                    <Button x:Name="RunSelectedButton" IsEnabled="{Binding IsRunSelectedEnabled}"
                            Content="EXECUTER LA SEQUENCE"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="170"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Executer la sequence guidee"
                            Command="{Binding RunSelectedCommand}" />
                    <Button x:Name="OpenWindowsUpdateButton" IsEnabled="{Binding IsIdle}"
                            Content="OUVRIR WINDOWS UPDATE"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="175"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Ouvrir Windows Update"
                            Command="{Binding OpenWindowsUpdateCommand}" />
                    <Button x:Name="InspectDriversButton" IsEnabled="{Binding IsIdle}"
                            Content="EXAMINER LES PILOTES"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="165"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Examiner les pilotes"
                            Command="{Binding InspectDriversCommand}" />
                    <Button x:Name="InstallDriversButton" IsEnabled="{Binding IsInstallDriversEnabled}"
                            Content="INSTALLER LES PILOTES"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="165"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Installer les pilotes"
                            Command="{Binding InstallDriversCommand}" Visibility="{Binding IsInstallDriversVisible, Converter={StaticResource BoolVisibility}}" />
                    <Button x:Name="ViewUpdatesReportButton" IsEnabled="{Binding IsReportButtonEnabled}"
                            Content="VOIR LE RAPPORT"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="145"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Voir le rapport mises a jour"
                            Command="{Binding ViewReportCommand}" />
                    <Button x:Name="ReturnHomeButton" IsEnabled="{Binding IsIdle}"
                            Content="RETOUR"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="100"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Retour accueil"
                            Command="{Binding ReturnHomeCommand}" />
                </WrapPanel>

                <Rectangle Style="{StaticResource VirgilSeparator}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource VirgilHudCard}"
                            Margin="0,0,6,8">
                        <StackPanel>
                            <TextBlock Text="ETAT GLOBAL" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="OverallStatusText"
                                       Text="{Binding OverallStatus}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,10" />
                            <TextBlock Text="WINGET" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="WingetStatusText"
                                       Text="{Binding WingetStatus}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1"
                            Style="{StaticResource VirgilHudCard}"
                            Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="WINDOWS UPDATE" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="WindowsUpdateStatusText"
                                       Text="{Binding WindowsUpdateStatus}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,10" />
                            <TextBlock Text="PILOTES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="DriversStatusText"
                                       Text="{Binding DriversStatus}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="APPLICATIONS"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <ItemsControl x:Name="UpdatesListPanel" ItemsSource="{Binding Entries}" KeyboardNavigation.TabNavigation="Continue" />

                <TextBlock Text="PILOTES"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <ItemsControl x:Name="DriversListPanel" ItemsSource="{Binding DriverCards}" ItemTemplate="{StaticResource UpdatesTextCardTemplate}" KeyboardNavigation.TabNavigation="Continue" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="UpdateValidationOverlay"
              Panel.ZIndex="20"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsValidationOpen, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="760"
                    MaxHeight="760"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl x:Name="ValidationCore"
                                                Width="72"
                                                Height="72"
                                                AnimationDetailLevel="Compact"
                                                IsHitTestVisible="False"
                                                AutomationProperties.Name="Mini noyau validation mise a jour" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VIRGIL" Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="ValidationTitleText"
                                   Text="{Binding ValidationTitle}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,18,0,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                            <TextBlock Text="DETAILS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationDetailsText"
                                       Text="{Binding ValidationDetails}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="COMMANDE PREPAREE" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationCommandText"
                                       Text="{Binding ValidationCommand}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="GARDE-FOUS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationSafetyText"
                                       Text="{Binding ValidationSafety}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                KeyboardNavigation.TabNavigation="Continue">
                        <Button x:Name="ExecuteUpdateButton"
                                Content="{Binding ExecuteLabel}"
                                Style="{StaticResource VirgilPrimaryButton}"
                                AutomationProperties.Name="Valider cette mise a jour"
                                Command="{Binding ExecuteDecisionCommand}" />
                        <Button x:Name="SkipUpdateButton"
                                Content="{Binding SkipLabel}"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Passer cette mise a jour"
                                Command="{Binding SkipDecisionCommand}" />
                        <Button x:Name="CancelSequenceButton"
                                Content="TOUT ANNULER"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Annuler la sequence"
                                Command="{Binding CancelDecisionCommand}" Visibility="{Binding IsCancelSequenceVisible, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="UpdatesReportOverlay"
              Panel.ZIndex="30"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsReportOpen, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="880"
                    MaxHeight="760"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RAPPORT MISES A JOUR"
                               Style="{StaticResource VirgilHudSectionTitle}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,16"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <TextBlock x:Name="UpdatesReportText"
                                   Text="{Binding ReportText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Button x:Name="CloseUpdatesReportButton"
                            Grid.Row="2"
                            Content="FERMER"
                            Style="{StaticResource VirgilSecondaryButton}"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Fermer le rapport mises a jour"
                            Command="{Binding CloseReportCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
