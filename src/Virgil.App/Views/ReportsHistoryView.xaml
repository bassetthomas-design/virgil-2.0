<UserControl x:Class="Virgil.App.Views.ReportsHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Virgil.App.Controls"
             MinWidth="0"
             MinHeight="0"
             KeyboardNavigation.TabNavigation="Continue"
             FocusManager.IsFocusScope="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <ScrollViewer x:Name="HistoryScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl x:Name="ReportsMiniCore"
                                                Width="72"
                                                Height="72"
                                                AnimationDetailLevel="Compact"
                                                AutomationProperties.Name="Mini noyau Virgil rapports" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RAPPORTS / HISTORIQUE"
                                   Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="ReportsStatusText" Text="{Binding StatusText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <WrapPanel KeyboardNavigation.TabNavigation="Continue">
                    <Button x:Name="LastPersistentReportButton"
                            IsEnabled="{Binding HasReports}"
                            Content="DERNIER RAPPORT"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="160"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Ouvrir le dernier rapport local"
                            Command="{Binding OpenLatestCommand}" />
                    <Button x:Name="RefreshHistoryButton"
                            Content="HISTORIQUE"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="135"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Actualiser l historique local"
                            Command="{Binding RefreshCommand}" />
                    <Button x:Name="ExportSelectedReportButton"
                            Content="EXPORTER RAPPORT"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="165"
                            Margin="0,0,8,8"
                            IsEnabled="{Binding IsExportEnabled}"
                            AutomationProperties.Name="Exporter manuellement le rapport sélectionné"
                            Command="{Binding ExportSelectedCommand}" />
                    <Button Content="RETOUR ACCUEIL"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="130"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Retour accueil"
                            Command="{Binding ReturnHomeCommand}" />
                </WrapPanel>

                <Border Style="{StaticResource VirgilHudCard}" Margin="0,2,0,8">
                    <StackPanel>
                        <TextBlock Text="CONFIDENTIALITÉ" Style="{StaticResource VirgilMicroLabel}" />
                        <TextBlock Text="Stockage local uniquement. Aucun envoi en ligne, aucune télémétrie, aucun export automatique."
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8" />
                        <TextBlock Text="Comparer deux scans : prévu en V2"
                                   Style="{StaticResource VirgilHudSecondaryText}" />
                    </StackPanel>
                </Border>

                <Rectangle Style="{StaticResource VirgilSeparator}" />

                <TextBlock Text="DERNIER RAPPORT"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                    <TextBlock x:Name="LatestReportSummaryText" Text="{Binding LatestSummaryText}"
                               Style="{StaticResource VirgilHudSecondaryText}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="HistoryHeading"
                           Text="HISTORIQUE LOCAL - 30 ÉVÉNEMENTS MAXIMUM"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <TextBlock x:Name="HistoryCountText" Text="{Binding HistoryCountText}"
                           Style="{StaticResource VirgilHudSecondaryText}"
                           Margin="0,0,0,8" />
                <ItemsControl x:Name="HistoryPanel" ItemsSource="{Binding Items}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource VirgilHudSecondaryText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource App.TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource VirgilHudSecondaryText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource VirgilHudSecondaryText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource VirgilHudSecondaryText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="OUVRIR" Command="{Binding OpenCommand}" Style="{StaticResource VirgilPrimaryButton}" MinWidth="100" Margin="0,0,8,0" />
                                        <Button Content="EXPORTER" Command="{Binding ExportCommand}" Style="{StaticResource VirgilSecondaryButton}" MinWidth="100" Margin="0,0,8,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource VirgilHudCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HistoryNotice}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding HistoryNotice}" Style="{StaticResource VirgilHudSecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ReportDetailsOverlay"
              Panel.ZIndex="30"
              Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibility}}"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="900"
                    MaxHeight="780"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailsTitleText" Text="{Binding DetailsTitle}"
                               Style="{StaticResource VirgilHudSectionTitle}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,16"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                            <TextBlock Text="VUE SIMPLE" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="SimpleDetailsText" Text="{Binding SimpleDetails}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,14" />
                            <TextBlock Text="ACTIONS PROPOSÉES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ProposedActionsText" Text="{Binding ProposedActions}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="ACTIONS EXÉCUTÉES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ExecutedActionsText" Text="{Binding ExecutedActions}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="ACTIONS PASSÉES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="SkippedActionsText" Text="{Binding SkippedActions}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="ERREURS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ErrorsText" Text="{Binding Errors}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <StackPanel x:Name="TechnicalDetailsPanel" Visibility="{Binding IsTechnicalDetailsVisible, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="DÉTAILS TECHNIQUES" Style="{StaticResource VirgilMicroLabel}" />
                                <TextBlock x:Name="TechnicalDetailsText" Text="{Binding TechnicalDetails}"
                                           Style="{StaticResource VirgilHudSecondaryText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                        <Button x:Name="ToggleTechnicalDetailsButton"
                                Content="{Binding ToggleTechnicalDetailsLabel}"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Afficher ou masquer les détails techniques"
                                Command="{Binding ToggleTechnicalDetailsCommand}" />
                        <Button x:Name="SaveTransientReportButton"
                                Content="ENREGISTRER DANS L HISTORIQUE"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="0,0,8,0"
                                Visibility="{Binding CanSaveTransient, Converter={StaticResource BooleanToVisibility}}"
                                AutomationProperties.Name="Enregistrer le rapport mémoire dans l historique local"
                                Command="{Binding SaveTransientCommand}" />
                        <Button Content="EXPORTER"
                                Style="{StaticResource VirgilPrimaryButton}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Exporter manuellement ce rapport"
                                Command="{Binding ExportCurrentCommand}" />
                        <Button x:Name="CloseReportDetailsButton"
                                Content="FERMER"
                                Style="{StaticResource VirgilSecondaryButton}"
                                AutomationProperties.Name="Fermer le rapport"
                                Command="{Binding CloseDetailsCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
