<UserControl x:Class="Virgil.App.Views.ReportsHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Virgil.App.Controls"
             MinWidth="0"
             MinHeight="0"
             KeyboardNavigation.TabNavigation="Continue"
             FocusManager.IsFocusScope="True">
    <Grid ClipToBounds="True">
        <ScrollViewer x:Name="HistoryScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl x:Name="ReportsMiniCore"
                                                Width="72"
                                                Height="72"
                                                AnimationDetailLevel="Compact"
                                                AutomationProperties.Name="Mini noyau Virgil rapports" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RAPPORTS / HISTORIQUE"
                                   Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="ReportsStatusText"
                                   Text="SCANS, ACTIONS ET EXPORTS LOCAUX"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <WrapPanel KeyboardNavigation.TabNavigation="Continue">
                    <Button x:Name="LastPersistentReportButton"
                            Content="DERNIER RAPPORT"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="160"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Ouvrir le dernier rapport local"
                            Click="LastReport_Click" />
                    <Button x:Name="RefreshHistoryButton"
                            Content="HISTORIQUE"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="135"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Actualiser l historique local"
                            Click="RefreshHistory_Click" />
                    <Button x:Name="ExportSelectedReportButton"
                            Content="EXPORTER RAPPORT"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="165"
                            Margin="0,0,8,8"
                            IsEnabled="False"
                            AutomationProperties.Name="Exporter manuellement le rapport selectionne"
                            Click="ExportSelectedReport_Click" />
                    <Button Content="RETOUR ACCUEIL"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="130"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Retour accueil"
                            Click="ReturnHome_Click" />
                </WrapPanel>

                <Border Style="{StaticResource VirgilHudCard}" Margin="0,2,0,8">
                    <StackPanel>
                        <TextBlock Text="CONFIDENTIALITE" Style="{StaticResource VirgilMicroLabel}" />
                        <TextBlock Text="Stockage local uniquement. Aucun envoi en ligne, aucune telemetrie, aucun export automatique."
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8" />
                        <TextBlock Text="Comparer deux scans : prevu en V2"
                                   Style="{StaticResource VirgilHudSecondaryText}" />
                    </StackPanel>
                </Border>

                <Rectangle Style="{StaticResource VirgilSeparator}" />

                <TextBlock Text="DERNIER RAPPORT"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                    <TextBlock x:Name="LatestReportSummaryText"
                               Text="Aucun rapport local disponible."
                               Style="{StaticResource VirgilHudSecondaryText}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="HistoryHeading"
                           Text="HISTORIQUE LOCAL - 30 EVENEMENTS MAXIMUM"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <TextBlock x:Name="HistoryCountText"
                           Text="0 rapport"
                           Style="{StaticResource VirgilHudSecondaryText}"
                           Margin="0,0,0,8" />
                <StackPanel x:Name="HistoryPanel" KeyboardNavigation.TabNavigation="Continue" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ReportDetailsOverlay"
              Panel.ZIndex="30"
              Visibility="Collapsed"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="900"
                    MaxHeight="780"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailsTitleText"
                               Text="RAPPORT"
                               Style="{StaticResource VirgilHudSectionTitle}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,16"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                            <TextBlock Text="VUE SIMPLE" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="SimpleDetailsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,14" />
                            <TextBlock Text="ACTIONS PROPOSEES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ProposedActionsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="ACTIONS EXECUTEES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ExecutedActionsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="ACTIONS PASSEES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="SkippedActionsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="ERREURS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ErrorsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <StackPanel x:Name="TechnicalDetailsPanel" Visibility="Collapsed">
                                <TextBlock Text="DETAILS TECHNIQUES" Style="{StaticResource VirgilMicroLabel}" />
                                <TextBlock x:Name="TechnicalDetailsText"
                                           Style="{StaticResource VirgilHudSecondaryText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                        <Button x:Name="ToggleTechnicalDetailsButton"
                                Content="VOIR DETAILS TECHNIQUES"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Afficher ou masquer les details techniques"
                                Click="ToggleTechnicalDetails_Click" />
                        <Button x:Name="SaveTransientReportButton"
                                Content="ENREGISTRER DANS L HISTORIQUE"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Enregistrer le rapport memoire dans l historique local"
                                Click="SaveTransientReport_Click" />
                        <Button Content="EXPORTER"
                                Style="{StaticResource VirgilPrimaryButton}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Exporter manuellement ce rapport"
                                Click="ExportCurrentReport_Click" />
                        <Button x:Name="CloseReportDetailsButton"
                                Content="FERMER"
                                Style="{StaticResource VirgilSecondaryButton}"
                                AutomationProperties.Name="Fermer le rapport"
                                Click="CloseReportDetails_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
