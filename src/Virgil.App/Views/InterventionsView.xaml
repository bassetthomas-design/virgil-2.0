<UserControl x:Class="Virgil.App.Views.InterventionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Virgil.App.Controls"
             MinWidth="0"
             MinHeight="0"
             KeyboardNavigation.TabNavigation="Continue"
             FocusManager.IsFocusScope="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="InterventionCardTemplate">
            <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsAvailable}" Margin="0,0,0,8"
                              Foreground="{DynamicResource App.TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource VirgilHudSecondaryText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:OperationProgressPanel Grid.Row="0" DataContext="{Binding Operation}" CancelAutomationId="InterventionsCancelButton"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      ClipToBounds="True">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl x:Name="InterventionsMiniCore"
                                                Width="72"
                                                Height="72"
                                                AnimationDetailLevel="Compact"
                                                AutomationProperties.Name="Mini noyau Virgil interventions" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Réparation"
                                   Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="InterventionsStatusText"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Analyse approfondie de l’image (DISM ScanHealth, facultatif)" IsChecked="{Binding IncludeDeepScan}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8" />
                <WrapPanel KeyboardNavigation.TabNavigation="Continue">
                    <Button x:Name="AnalyzeInterventionsButton"
                            IsEnabled="{Binding IsIdle}"
                            Content="Vérifier"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="210"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Analyser les interventions"
                            Command="{Binding VerifyHealthCommand}" />
                    <Button x:Name="RunGuidedButton"
                            IsEnabled="{Binding IsIdle}"
                            Content="Scanner et réparer"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="205"
                            Margin="0,0,8,8"

                            AutomationProperties.Name="Lancer le parcours guide"
                            Command="{Binding ScanRepairCommand}" />
                    <Button x:Name="ViewInterventionsReportButton"
                            IsEnabled="{Binding IsReportButtonEnabled}"
                            Content="VOIR LE DERNIER RAPPORT"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="190"
                            Margin="0,0,8,8"

                            AutomationProperties.Name="Voir le dernier rapport interventions"
                            Command="{Binding ViewReportCommand}" />
                    <Button x:Name="ReturnHomeButton"
                            Content="RETOUR ACCUEIL"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="130"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Retour accueil"
                            Command="{Binding ReturnHomeCommand}" />
                </WrapPanel>

                <Rectangle Style="{StaticResource VirgilSeparator}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,6,8">
                        <StackPanel>
                            <TextBlock Text="ÉTAT GLOBAL" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="InterventionsOverallText"
                                       Text="{Binding OverallText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,10" />
                            <TextBlock Text="ACTIONS RECOMMANDÉES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="RecommendedCountText"
                                       Text="{Binding RecommendedCountText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource VirgilHudCard}" Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="GARDE-FOUS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock Text="Validation separee par action. Aucune commande libre. Aucun redemarrage automatique."
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,10" />
                            <TextBlock Text="HELPER ÉLEVÉ" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock Text="Lancement uniquement après confirmation d'une action admin."
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="SYSTÈME"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <StackPanel>
                    <Border Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource VirgilHudCard}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SystemNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SystemNotice}" Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </Border>
                    <ItemsControl x:Name="SystemActionsPanel" ItemsSource="{Binding SystemItems}"
                                  ItemTemplate="{StaticResource InterventionCardTemplate}"
                                  KeyboardNavigation.TabNavigation="Continue" />
                </StackPanel>

                <TextBlock Text="RÉSEAU"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <StackPanel>
                    <Border Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource VirgilHudCard}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NetworkNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding NetworkNotice}" Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </Border>
                    <ItemsControl x:Name="NetworkActionsPanel" ItemsSource="{Binding NetworkItems}"
                                  ItemTemplate="{StaticResource InterventionCardTemplate}"
                                  KeyboardNavigation.TabNavigation="Continue" />
                </StackPanel>

                <TextBlock Text="STOCKAGE"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <StackPanel>
                    <Border Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource VirgilHudCard}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StorageNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StorageNotice}" Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </Border>
                    <ItemsControl x:Name="StorageActionsPanel" ItemsSource="{Binding StorageItems}"
                                  ItemTemplate="{StaticResource InterventionCardTemplate}"
                                  KeyboardNavigation.TabNavigation="Continue" />
                </StackPanel>

                <TextBlock Text="INTERFACE WINDOWS"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <StackPanel>
                    <Border Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource VirgilHudCard}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InterfaceNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding InterfaceNotice}" Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </Border>
                    <ItemsControl x:Name="InterfaceActionsPanel" ItemsSource="{Binding InterfaceItems}"
                                  ItemTemplate="{StaticResource InterventionCardTemplate}"
                                  KeyboardNavigation.TabNavigation="Continue" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" x:Name="InterventionValidationOverlay"
              Panel.ZIndex="20"
              Visibility="{Binding IsValidationOpen, Converter={StaticResource BoolToVisibility}}"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="820"
                    MaxHeight="780"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl x:Name="ValidationCore"
                                                Width="72"
                                                Height="72"
                                                AnimationDetailLevel="Compact"
                                                IsHitTestVisible="False"
                                                AutomationProperties.Name="Mini noyau validation intervention" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VIRGIL" Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="ValidationTitleText"
                                   Text="{Binding ValidationTitle}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,18,0,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                            <TextBlock Text="EXPLICATION" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationDetailsText"
                                       Text="{Binding ValidationDetails}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="COMMANDE AUTORISÉE" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationCommandText"
                                       Text="{Binding ValidationCommand}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="GARDE-FOUS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock Text="{Binding CriticalConfirmationPrompt}" TextWrapping="Wrap" Style="{StaticResource VirgilHudSecondaryText}" />
                            <TextBox Text="{Binding TypedConfirmation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Confirmation Critique sans point de restauration" />
                            <TextBlock x:Name="ValidationSafetyText"
                                       Text="{Binding ValidationSafety}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                KeyboardNavigation.TabNavigation="Continue">
                        <Button x:Name="ExecuteInterventionButton"
                                Content="{Binding ExecuteActionLabel}"
                                Style="{StaticResource VirgilPrimaryButton}"
                                AutomationProperties.Name="Exécuter cette intervention"
                                Command="{Binding ExecuteDecisionCommand}" />
                        <Button x:Name="SkipInterventionButton"
                                Content="PASSER"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Passer cette intervention"
                                Command="{Binding SkipDecisionCommand}" />
                        <Button x:Name="CancelAllInterventionsButton"
                                Content="ANNULER TOUT"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Annuler le parcours"
                                Command="{Binding CancelDecisionCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" x:Name="InterventionsReportOverlay"
              Panel.ZIndex="30"
              Visibility="{Binding IsReportOpen, Converter={StaticResource BoolToVisibility}}"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="880"
                    MaxHeight="760"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RAPPORT INTERVENTIONS"
                               Style="{StaticResource VirgilHudSectionTitle}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,16"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <TextBlock x:Name="InterventionsReportText"
                                   Text="{Binding ReportText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Button x:Name="CloseInterventionsReportButton"
                            Grid.Row="2"
                            Content="FERMER"
                            Style="{StaticResource VirgilSecondaryButton}"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Fermer le rapport interventions"
                            Command="{Binding CloseReportCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
