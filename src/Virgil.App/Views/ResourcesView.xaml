<UserControl x:Class="Virgil.App.Views.ResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Virgil.App.Controls"
             MinWidth="0"
             MinHeight="0"
             KeyboardNavigation.TabNavigation="Continue"
             FocusManager.IsFocusScope="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <ScrollViewer x:Name="ResourcesScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      ClipToBounds="True">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl x:Name="ResourcesMiniCore"
                                                Width="72"
                                                Height="72"
                                                AnimationDetailLevel="Compact"
                                                AutomationProperties.Name="Mini noyau Virgil ressources" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RESSOURCES SYSTÈME"
                                   Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="ResourcesStatusText"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <WrapPanel KeyboardNavigation.TabNavigation="Continue">
                    <Button x:Name="AnalyzeResourcesButton"
                            IsEnabled="{Binding IsIdle}"
                            Content="ANALYSER RESSOURCES"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="190"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Analyser les ressources"
                            Command="{Binding AnalyzeCommand}" />
                    <Button x:Name="HeavyProcessesButton"
                            IsEnabled="{Binding IsIdle}"
                            Content="PROCESSUS LOURDS"
                            Style="{StaticResource VirgilPrimaryButton}"
                            MinWidth="160"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Afficher les processus lourds"
                            Command="{Binding HeavyProcessesCommand}" />
                    <Button x:Name="ReleaseInactiveMemoryButton"
                            IsEnabled="{Binding IsIdle}"
                            Content="{Binding ReleaseInactiveMemoryLabel}"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="210"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Informations sur la libération de mémoire inactive"
                            Command="{Binding ReleaseInactiveMemoryCommand}" />
                    <Button x:Name="RestartExplorerButton"
                            IsEnabled="{Binding IsIdle}"
                            Content="RELANCER EXPLORER"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="160"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Relancer Explorer Windows"
                            Command="{Binding RestartExplorerCommand}" />
                    <Button x:Name="ViewResourcesReportButton"
                            Content="VOIR LE RAPPORT"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="145"
                            Margin="0,0,8,8"
                            IsEnabled="{Binding IsReportButtonEnabled}"
                            AutomationProperties.Name="Voir le rapport ressources"
                            Command="{Binding ViewReportCommand}" />
                    <Button x:Name="ReturnHomeButton"
                            IsEnabled="{Binding IsIdle}"
                            Content="RETOUR ACCUEIL"
                            Style="{StaticResource VirgilSecondaryButton}"
                            MinWidth="130"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Retour accueil"
                            Command="{Binding ReturnHomeCommand}" />
                </WrapPanel>

                <Rectangle Style="{StaticResource VirgilSeparator}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,6,8">
                        <StackPanel>
                            <TextBlock Text="CPU - OBSERVATION COURTE" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="CpuSummaryText"
                                       Text="{Binding CpuSummaryText}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,10" />
                            <TextBlock Text="RAM" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="MemorySummaryText"
                                       Text="{Binding MemorySummaryText}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource VirgilHudCard}" Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="SESSION WINDOWS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="SessionSummaryText"
                                       Text="{Binding SessionSummaryText}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,4,0,10" />
                            <TextBlock Text="GARDE-FOUS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock Text="Aucune fermeture automatique. Processus critiques bloqués. Aucun redémarrage force."
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="RECOMMANDATIONS"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                    <TextBlock x:Name="RecommendationsText"
                               Text="{Binding RecommendationsText}"
                               Style="{StaticResource VirgilHudSecondaryText}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="ProcessListHeading"
                           Text="PROCESSUS PRINCIPAUX"
                           Style="{StaticResource VirgilHudSectionTitle}"
                           Margin="0,8,0,6" />
                <TextBlock x:Name="ProcessSummaryText"
                           Text="{Binding ProcessSummaryText}"
                           Style="{StaticResource VirgilHudSecondaryText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <Border Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource VirgilHudCard}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProcessesNotice}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ProcessesNotice}" Style="{StaticResource VirgilHudSecondaryText}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </Border>
                <ItemsControl x:Name="ProcessesPanel" ItemsSource="{Binding Items}" IsEnabled="{Binding IsIdle}"
                              KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource VirgilHudCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource VirgilHudSecondaryText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding UsageLine}" Style="{StaticResource VirgilHudSecondaryText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding PublisherLine}" Style="{StaticResource VirgilHudSecondaryText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding UserMessage}" Style="{StaticResource VirgilHudSecondaryText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="OUVRIR EMPLACEMENT" Command="{Binding OpenLocationCommand}"
                                                Style="{StaticResource VirgilSecondaryButton}"
                                                MinWidth="125" Margin="0,0,8,6"
                                                Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="FERMER PROPREMENT" Command="{Binding CloseGracefullyCommand}"
                                                Style="{StaticResource VirgilPrimaryButton}"
                                                MinWidth="125" Margin="0,0,8,6"
                                                Visibility="{Binding CanCloseGracefully, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="FORCER FERMETURE" Command="{Binding ForceCloseCommand}"
                                                Style="{StaticResource VirgilSecondaryButton}"
                                                MinWidth="125" Margin="0,0,8,6"
                                                Visibility="{Binding CanForceClose, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="IGNORER" Command="{Binding IgnoreCommand}"
                                                Style="{StaticResource VirgilSecondaryButton}"
                                                MinWidth="125" Margin="0,0,8,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ResourceValidationOverlay"
              Panel.ZIndex="20"
              Visibility="{Binding IsValidationOpen, Converter={StaticResource BoolToVisibility}}"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="820"
                    MaxHeight="720"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl x:Name="ValidationCore"
                                                Width="72"
                                                Height="72"
                                                AnimationDetailLevel="Compact"
                                                IsHitTestVisible="False"
                                                AutomationProperties.Name="Mini noyau validation ressources" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VIRGIL" Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="ValidationTitleText"
                                   Text="{Binding ValidationTitle}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,18,0,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                            <TextBlock Text="ACTION" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationDetailsText"
                                       Text="{Binding ValidationDetails}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="GARDE-FOUS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationSafetyText"
                                       Text="{Binding ValidationSafety}"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="ExecuteResourceActionButton"
                                Content="{Binding ExecuteActionLabel}"
                                Style="{StaticResource VirgilPrimaryButton}"
                                AutomationProperties.Name="Exécuter l action ressources"
                                Command="{Binding ExecuteDecisionCommand}" />
                        <Button Content="PASSER"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Passer cette action"
                                Command="{Binding SkipDecisionCommand}" />
                        <Button Content="ANNULER TOUT"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Annuler l action ressources"
                                Command="{Binding CancelDecisionCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ResourcesReportOverlay"
              Panel.ZIndex="30"
              Visibility="{Binding IsReportOpen, Converter={StaticResource BoolToVisibility}}"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="880"
                    MaxHeight="760"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RAPPORT RESSOURCES"
                               Style="{StaticResource VirgilHudSectionTitle}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,16"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <TextBlock x:Name="ResourcesReportText"
                                       Text="{Binding ReportText}"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Button x:Name="CloseResourcesReportButton"
                            Grid.Row="2"
                            Content="FERMER"
                            Style="{StaticResource VirgilSecondaryButton}"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Fermer le rapport ressources"
                            Command="{Binding CloseReportCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
