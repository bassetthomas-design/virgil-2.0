<UserControl x:Class="Virgil.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Virgil.App.ViewModels"
             xmlns:controls="clr-namespace:Virgil.App.Controls"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:CleanupSectionTitleItem}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource VirgilHudSectionTitle}" TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupTextCardItem}">
            <Border Style="{StaticResource VirgilHudCard}" Margin="0,6,0,6">
                <TextBlock Text="{Binding Text}" Style="{StaticResource VirgilHudSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupZoneItemViewModel}">
            <Border Style="{StaticResource VirgilHudCard}" Margin="0,6,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource VirgilHudSectionTitle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource VirgilHudSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupReviewItemViewModel}">
            <Border Margin="0,6,0,6">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource VirgilHudCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource VirgilHudSectionTitle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource VirgilHudSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="OUVRIR L'EMPLACEMENT" Style="{StaticResource VirgilSecondaryButton}" Command="{Binding OpenLocationCommand}" />
                        <Button Content="IGNORER" Style="{StaticResource VirgilSecondaryButton}" Margin="8,0,0,0" Command="{Binding IgnoreCommand}" />
                        <Button Content="MARQUER À REVOIR" Style="{StaticResource VirgilSecondaryButton}" Margin="8,0,0,0" Command="{Binding MarkCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid x:Name="CleanupContentRoot"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:VirgilCoreControl x:Name="CleanupMiniCore"
                                            Width="58"
                                            Height="58"
                                            AnimationDetailLevel="Compact"
                                            IsHitTestVisible="False"
                                            AutomationProperties.Name="Mini noyau Virgil nettoyage" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="NETTOYAGE COMPLET GUIDE V2"
                               Style="{StaticResource VirgilHudSectionTitle}"
                               FontSize="22" />
                    <TextBlock Text="SÉLECTION PAR GROUPE OU LIGNE, PUIS CONFIRMATION RÉCAPITULATIVE"
                               Style="{StaticResource VirgilHudSecondaryText}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="CleanupStatusText"
                               Text="{Binding StatusText}"
                               Style="{StaticResource VirgilHudSecondaryText}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="1"
                       Margin="0,16,0,10"
                       KeyboardNavigation.TabNavigation="Continue">
                <Button x:Name="AnalyzeZonesButton"
                        Content="ANALYSER NETTOYAGE COMPLET"
                        Style="{StaticResource VirgilPrimaryButton}"
                        AutomationProperties.Name="Analyser les zones de nettoyage"
                        Command="{Binding AnalyzeZonesCommand}"
                        IsEnabled="{Binding IsAnalyzeEnabled}" />
                <Button x:Name="LaunchCleanupButton"
                        Content="NETTOYER LA SÉLECTION"
                        Style="{StaticResource VirgilPrimaryButton}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsLaunchCleanupEnabled}"
                        AutomationProperties.Name="Lancer le nettoyage guide"
                        Command="{Binding LaunchCleanupSafeCommand}" />
                <Button x:Name="AdvancedCleanupButton"
                        Content="CONFIRMER LA SÉLECTION" Visibility="Collapsed"
                        Style="{StaticResource VirgilPrimaryButton}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsAdvancedCleanupEnabled}"
                        AutomationProperties.Name="Lancer le nettoyage avance guide"
                        Command="{Binding LaunchCleanupAdvancedCommand}" />
                <Button x:Name="ReviewManualButton"
                        Content="À REVOIR MANUELLEMENT"
                        Style="{StaticResource VirgilSecondaryButton}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsReviewManualEnabled}"
                        AutomationProperties.Name="Afficher les éléments à revoir manuellement"
                        Command="{Binding ReviewManualCommand}" />
                <Button x:Name="ViewCleanupReportButton"
                        Content="VOIR LE DERNIER RAPPORT"
                        Style="{StaticResource VirgilSecondaryButton}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsReportButtonEnabled}"
                        AutomationProperties.Name="Voir le dernier rapport de nettoyage"
                        Command="{Binding ViewReportCommand}" />
                <Button x:Name="ReturnHomeButton"
                        Content="RETOUR ACCUEIL"
                        Style="{StaticResource VirgilSecondaryButton}"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Retour accueil"
                        Command="{Binding ReturnHomeCommand}"
                        IsEnabled="{Binding IsReturnHomeEnabled}" />
            </WrapPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <controls:OperationProgressPanel DataContext="{Binding Operation}" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel Grid.Row="1" Margin="0,8">
                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource App.TextPrimaryBrush}" FontSize="20"/>
                    <TextBlock Text="{Binding SafetySummary}" Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                    <WrapPanel IsEnabled="{Binding IsIdle}" Margin="0,8,0,4">
                        <Button Content="TOUT SÉLECTIONNER" Command="{Binding SelectAllCommand}" Style="{StaticResource VirgilSecondaryButton}"/>
                        <Button Content="TOUT DÉSÉLECTIONNER" Command="{Binding DeselectAllCommand}" Style="{StaticResource VirgilSecondaryButton}" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="La sélection globale et par catégorie exclut les dossiers personnels, les Téléchargements, la Corbeille (suppression irréversible), Windows.old et les lignes non exécutables." TextWrapping="Wrap" Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                </StackPanel>
                <ListBox Grid.Row="2" x:Name="ZonesPanel" Foreground="{DynamicResource App.TextPrimaryBrush}" ItemsSource="{Binding Categories}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Header}" Margin="0,6">
                                <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="IsExpanded" Value="False"/>
                                    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                        <Grid IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <CheckBox Content="Sélectionner toute la catégorie"
                                                      IsThreeState="True" IsChecked="{Binding Selection.IsSelected, Mode=TwoWay}" Margin="8"/>
                                            <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" MaxHeight="420" Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                                     HorizontalContentAlignment="Stretch">
                                                <ListBox.ItemTemplate><DataTemplate>
                                                    <StackPanel Margin="4,8">
                                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}">
                                                            <StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}"/><TextBlock Text="{Binding NatureAndRisk}" Foreground="{DynamicResource App.TextPrimaryBrush}"/></StackPanel>
                                                        </CheckBox>
                                                        <Expander Header="Détails techniques" Margin="20,4,0,0">
                                                            <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers>
                                                                <Trigger Property="IsExpanded" Value="True"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                                                    <TextBlock Text="{Binding Détails}" TextWrapping="Wrap"/>
                                                                </DataTemplate></Setter.Value></Setter></Trigger>
                                                            </Style.Triggers></Style></Expander.Style>
                                                            <Expander.Content><Binding/></Expander.Content>
                                                        </Expander>
                                                    </StackPanel>
                                                </DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </DataTemplate></Setter.Value></Setter>
                                </Style></Expander.Style>
                                <Expander.Content><Binding/></Expander.Content>
                            </Expander>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3">
                    <Expander Header="Informations complémentaires (lecture seule)">
                        <ListBox ItemsSource="{Binding Entries}" MaxHeight="240" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"/>
                    </Expander>
                    <Expander Header="Quarantaine">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Restauration vérifiée pendant la rétention. Aucun espace libéré avant la purge." TextWrapping="Wrap" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding QuarantineItems}" MaxHeight="240"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource App.TextPrimaryBrush}" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding Détails}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ExpirationStatus}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="2" IsEnabled="{Binding IsIdle}">
                                <Button Content="Actualiser" Command="{Binding RefreshQuarantineCommand}" Margin="4" />
                                <Button Content="Restaurer" Command="{Binding RestoreQuarantineCommand}" Margin="4" />
                                <Button Content="Vider la quarantaine maintenant" Command="{Binding PurgeQuarantineCommand}" Margin="4" />
                                <Button Content="{Binding ExpiredQuarantineLabel}" Command="{Binding PurgeExpiredQuarantineCommand}"
                                        Visibility="{Binding HasExpiredQuarantine, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4" />
                            </WrapPanel>
                            <TextBlock Grid.Row="3" Text="Pour vider toute la quarantaine, laissez la sélection vide." TextWrapping="Wrap" />
                        </Grid>
                    </Expander>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="ZoneValidationOverlay"
              Panel.ZIndex="40"
              Visibility="{Binding IsValidationOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="640"
                    MaxHeight="720"
                    Margin="18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:VirgilCoreControl x:Name="ValidationCore"
                                                Width="64"
                                                Height="64"
                                                AnimationDetailLevel="Compact"
                                                IsHitTestVisible="False"
                                                AutomationProperties.Name="Mini noyau Virgil nettoyage" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="VIRGIL"
                                   Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock x:Name="ValidationZoneTitleText"
                                   Text="{Binding ValidationTitle}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,18,0,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                            <TextBlock x:Name="ValidationReasonText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       FontWeight="SemiBold"
                                       Text="{Binding ValidationReason}" />
                            <Rectangle Style="{StaticResource VirgilSeparator}" />
                            <TextBlock Text="RACINE LOGIQUE"
                                       Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationRootText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,3,0,10"
                                       Text="{Binding ValidationRoot}" />
                            <TextBlock Text="PRÉVISUALISATION"
                                       Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationMetricsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,3,0,10"
                                       Text="{Binding ValidationMetrics}" />
                            <TextBlock Text="EFFET"
                                       Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationEffectText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,3,0,10"
                                       Text="{Binding ValidationEffect}" />
                            <TextBlock Text="NON TOUCHÉ"
                                       Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationNotTouchedText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,3,0,10"
                                       Text="{Binding ValidationNotTouched}" />
                            <TextBlock Text="AVERTISSEMENT"
                                       Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ValidationWarningText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,3,0,0"
                                       Text="{Binding ValidationWarning}" />
                            <StackPanel Visibility="{Binding RequiresCriticalConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ExpectedCriticalConfirmation}" TextWrapping="Wrap" Foreground="{DynamicResource App.TextPrimaryBrush}" />
                                <TextBox Text="{Binding CriticalConfirmationText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Confirmation du dossier personnel" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <TextBlock x:Name="CleanupConfirmationSummaryText" Text="{Binding ValidationNatureSummary}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    KeyboardNavigation.TabNavigation="Continue">
                            <Button x:Name="ExecuteZoneButton"
                                    Content="{Binding ExecuteZoneLabel}"
                                    Style="{StaticResource VirgilPrimaryButton}"
                                    AutomationProperties.Name="Exécuter le nettoyage de cette zone"
                                    Command="{Binding ExecuteDecisionCommand}" />
                            <Button x:Name="SkipZoneButton"
                                    Content="PASSER"
                                    Style="{StaticResource VirgilSecondaryButton}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="Passer cette zone"
                                    Command="{Binding SkipDecisionCommand}" />
                            <Button x:Name="CancelAllButton"
                                    Content="ANNULER TOUT"
                                    Style="{StaticResource VirgilSecondaryButton}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="Annuler tout le nettoyage guide"
                                    Command="{Binding CancelDecisionCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="CleanupReportOverlay"
              Panel.ZIndex="45"
              Visibility="{Binding IsReportOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    MaxWidth="700"
                    MaxHeight="720"
                    Margin="18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:VirgilCoreControl x:Name="ReportCore"
                                                    Width="58"
                                                    Height="58"
                                                    AnimationDetailLevel="Compact"
                                                    IsHitTestVisible="False"
                                                    AutomationProperties.Name="Mini noyau Virgil rapport nettoyage" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="VIRGIL"
                                       Style="{StaticResource VirgilHudSectionTitle}" />
                            <TextBlock Text="RAPPORT NETTOYAGE"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <TextBlock x:Name="CleanupReportText"
                                   Style="{StaticResource VirgilHudSecondaryText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding ReportText}" />
                    </ScrollViewer>
                    <Button x:Name="CloseCleanupReportButton"
                            Grid.Row="2"
                            Content="FERMER"
                            Style="{StaticResource VirgilSecondaryButton}"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Fermer le rapport nettoyage"
                            Command="{Binding CloseReportCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
