<Window x:Class="Virgil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Virgil.App.Controls"
        Title="Virgil 2.0"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="660"
        Background="{DynamicResource App.BackgroundBrush}"
        Foreground="{DynamicResource App.TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource VirgilHudPanel}"
                    Effect="{StaticResource VirgilAccentGlow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VIRGIL 2.0" Style="{StaticResource VirgilAppTitle}" />
                        <TextBlock Text="Agent tactique PC" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <Ellipse x:Name="StatusIndicator"
                                 Width="12"
                                 Height="12"
                                 Fill="{DynamicResource App.SuccessBrush}"
                                 Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="ÉTAT GLOBAL" Style="{StaticResource VirgilMicroLabel}" TextAlignment="Right" />
                            <TextBlock x:Name="StatusText"
                                       Text="Système prêt"
                                       Foreground="{DynamicResource App.AccentBrush}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" MinWidth="440" />
                    <ColumnDefinition Width="0.88*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource VirgilHudPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:VirgilCoreControl x:Name="MainCore"
                                                        Grid.Row="0"
                                                        Width="320"
                                                        Height="320"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        CoreState="Idle" />

                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0">
                                <TextBlock x:Name="VirgilStateText"
                                           Text="REPOS"
                                           Style="{StaticResource VirgilCoreStatusText}"
                                           TextAlignment="Center" />
                                <TextBlock x:Name="ScanHintText"
                                           Text="Scan rapide ou analyse approfondie"
                                           Style="{StaticResource VirgilHudSecondaryText}"
                                           TextAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0">
                            <Button x:Name="FullScanButton"
                                    Content="SCAN COMPLET"
                                    Style="{StaticResource VirgilPrimaryButton}"
                                    MinWidth="190"
                                    Click="ShowScanOptions_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource VirgilHudPanel}" Margin="12,0,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="CHATBOX VIRGIL"
                                   Style="{StaticResource VirgilSectionTitle}"
                                   Margin="0,0,0,12" />

                        <WrapPanel x:Name="ContextActionsPanel"
                                   DockPanel.Dock="Bottom"
                                   Margin="0,12,0,0" />

                        <ScrollViewer x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChatMessages" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="2" Columns="4">
                <Border Style="{StaticResource VirgilMetricCard}">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource VirgilHudTitle}" />
                        <TextBlock x:Name="RamMetricText" Text="N/A" Style="{StaticResource VirgilHudMetric}" Margin="0,8,0,0" />
                        <TextBlock x:Name="RamDetailText" Text="En attente d'analyse" Style="{StaticResource VirgilHudSecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource VirgilMetricCard}">
                    <StackPanel>
                        <TextBlock Text="DISQUE SYSTÈME" Style="{StaticResource VirgilHudTitle}" />
                        <TextBlock x:Name="DiskMetricText" Text="N/A" Style="{StaticResource VirgilHudMetric}" Margin="0,8,0,0" />
                        <TextBlock x:Name="DiskDetailText" Text="En attente d'analyse" Style="{StaticResource VirgilHudSecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource VirgilMetricCard}">
                    <StackPanel>
                        <TextBlock Text="NETTOYAGE POTENTIEL" Style="{StaticResource VirgilHudTitle}" />
                        <TextBlock x:Name="CleanupMetricText" Text="N/A" Style="{StaticResource VirgilHudMetric}" Margin="0,8,0,0" />
                        <TextBlock x:Name="CleanupDetailText" Text="Prévisualisation uniquement" Style="{StaticResource VirgilHudSecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource VirgilMetricCard}">
                    <StackPanel>
                        <TextBlock Text="PRIORITÉS" Style="{StaticResource VirgilHudTitle}" />
                        <TextBlock x:Name="PriorityMetricText" Text="0" Style="{StaticResource VirgilHudMetric}" Margin="0,8,0,0" />
                        <TextBlock x:Name="PriorityDetailText" Text="Aucune analyse récente" Style="{StaticResource VirgilHudSecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <Grid x:Name="ScanOverlay"
              Visibility="Collapsed"
              Background="#D605070A">
            <Border Style="{StaticResource VirgilOverlayPanel}"
                    Width="520"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <controls:VirgilCoreControl x:Name="OverlayCore"
                                                Width="118"
                                                Height="118"
                                                HorizontalAlignment="Center"
                                                CoreState="Communicating"
                                                Margin="0,0,0,10" />
                    <TextBlock Text="VIRGIL — SÉLECTION DU PROTOCOLE"
                               Style="{StaticResource VirgilSectionTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="Choisir le niveau d'analyse. Aucune suppression ni modification système ne sera effectuée."
                               Style="{StaticResource VirgilHudSecondaryText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="QuickScanButton"
                                Grid.Column="0"
                                Content="SCAN RAPIDE"
                                Style="{StaticResource VirgilPrimaryButton}"
                                Margin="0,0,8,0"
                                Click="RunQuickScan_Click" />
                        <Button x:Name="DeepScanButton"
                                Grid.Column="1"
                                Content="ANALYSE APPROFONDIE"
                                Style="{StaticResource VirgilPrimaryButton}"
                                Margin="0,0,8,0"
                                Click="RunDeepScan_Click" />
                        <Button Grid.Column="2"
                                Content="ANNULER"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Click="CancelScan_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
