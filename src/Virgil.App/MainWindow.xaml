<Window x:Class="Virgil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Virgil.App.Controls"
        Title="Virgil 2.0"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="720"
        Background="{DynamicResource App.BackgroundBrush}"
        Foreground="{DynamicResource App.TextPrimaryBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Focusable="False">
            <Grid MinWidth="1040" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="520" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource VirgilHudPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="VIRGIL 2.0"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.TextPrimaryBrush}" />
                            <TextBlock Text="AGENT TACTIQUE SYSTEME"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    KeyboardNavigation.TabNavigation="Continue">
                            <Border Style="{StaticResource VirgilBadge}">
                                <TextBlock x:Name="StatusText"
                                           Text="SYSTEME PRET"
                                           Style="{StaticResource VirgilMicroLabel}"
                                           Foreground="{DynamicResource App.TextPrimaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource VirgilBadge}">
                                <TextBlock x:Name="SessionTimeText"
                                           Text="SESSION LOCALE"
                                           Style="{StaticResource VirgilMicroLabel}"
                                           Foreground="{DynamicResource App.TextPrimaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource VirgilBadge}">
                                <TextBlock Text="LOCAL"
                                           Style="{StaticResource VirgilMicroLabel}"
                                           Foreground="{DynamicResource App.TextPrimaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource VirgilBadge}">
                                <TextBlock Text="PREVIEW"
                                           Style="{StaticResource VirgilMicroLabel}"
                                           Foreground="{DynamicResource App.TextPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,14,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" MinWidth="430" />
                        <ColumnDefinition Width="350" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource VirgilHudPanel}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="NAVIGATION"
                                       Style="{StaticResource VirgilHudSectionTitle}"
                                       Margin="0,0,0,12" />
                            <StackPanel x:Name="NavigationPanel"
                                        KeyboardNavigation.TabNavigation="Continue">
                                <Button Style="{StaticResource VirgilNavButton}"
                                        Tag="Active"
                                        AutomationProperties.Name="Accueil"
                                        Click="Home_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="9" Height="9" Fill="{DynamicResource App.AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="ACCUEIL" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Scan" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="10" Height="10" Stroke="{DynamicResource App.AccentBrush}" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="SCAN" /></Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Nettoyage" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="M2,8 L8,2 L12,8 Z" Stroke="{DynamicResource App.AccentBrush}" Fill="Transparent" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="NETTOYAGE" /></Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Ressources" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Width="10" Height="6" Stroke="{DynamicResource App.AccentBrush}" Fill="Transparent" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="RESSOURCES" /></Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Applications" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="M2,2 H11 V11 H2 Z M5,5 H14 V14 H5 Z" Stroke="{DynamicResource App.AccentBrush}" Fill="Transparent" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="APPLICATIONS" /></Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Mises a jour" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="M8,1 L13,6 H10 V13 H6 V6 H3 Z" Stroke="{DynamicResource App.AccentBrush}" Fill="Transparent" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="MISES A JOUR" /></Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Demarrage" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="M8,2 V8 M4,5 A5,5 0 1 0 12,5" Stroke="{DynamicResource App.AccentBrush}" Fill="Transparent" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="DEMARRAGE" /></Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Reseau" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="M2,8 H6 M10,8 H14 M7,5 H9 V11 H7 Z" Stroke="{DynamicResource App.AccentBrush}" Fill="Transparent" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="RESEAU" /></Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Reparation" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="M3,12 L12,3 M10,2 L13,5 M2,10 L5,13" Stroke="{DynamicResource App.AccentBrush}" Fill="Transparent" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="REPARATION" /></Grid>
                                </Button>
                                <Button Style="{StaticResource VirgilNavButton}" AutomationProperties.Name="Rapports" Click="ModulePlaceholder_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="M3,2 H12 V14 H3 Z M5,5 H10 M5,8 H10 M5,11 H8" Stroke="{DynamicResource App.AccentBrush}" Fill="Transparent" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="RAPPORTS" /></Grid>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource VirgilHudPanel}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,18">
                                <controls:VirgilCoreControl x:Name="VirgilCore"
                                                            Width="310"
                                                            Height="310"
                                                            HorizontalAlignment="Center"
                                                            AutomationProperties.Name="Noyau Virgil" />
                                <TextBlock x:Name="VirgilStateText"
                                           Text="ETAT VIRGIL : REPOS"
                                           Style="{StaticResource VirgilHudSectionTitle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <Button x:Name="MainScanButton"
                                        Content="SCAN COMPLET"
                                        Style="{StaticResource VirgilPrimaryButton}"
                                        FontSize="15"
                                        Padding="28,12"
                                        Margin="0,18,0,0"
                                        AutomationProperties.Name="Scan complet"
                                        Click="OpenScanProtocol_Click" />
                                <TextBlock Text="ANALYSE RAPIDE OU APPROFONDIE"
                                           Style="{StaticResource VirgilHudSecondaryText}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Rectangle Style="{StaticResource VirgilSeparator}" />
                                <TextBlock Grid.Row="1" Text="RAPPORT TACTIQUE" Style="{StaticResource VirgilHudSectionTitle}" />
                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ETAT GLOBAL" Style="{StaticResource VirgilMicroLabel}" />
                                        <TextBlock x:Name="GlobalStatusText" Text="EN ATTENTE" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,3,0,8" />
                                        <TextBlock Text="CPU" Style="{StaticResource VirgilMicroLabel}" />
                                        <TextBlock x:Name="ReportCpuText" Text="EN ATTENTE" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,3,0,8" />
                                        <TextBlock Text="RAM" Style="{StaticResource VirgilMicroLabel}" />
                                        <TextBlock x:Name="ReportRamText" Text="EN ATTENTE" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,3,0,8" />
                                        <TextBlock Text="DISQUE" Style="{StaticResource VirgilMicroLabel}" />
                                        <TextBlock x:Name="ReportDiskText" Text="EN ATTENTE" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBlock Text="NETTOYAGE POTENTIEL" Style="{StaticResource VirgilMicroLabel}" />
                                        <TextBlock x:Name="ReportCleanupText" Text="NON ANALYSE" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,3,0,8" />
                                        <TextBlock Text="RECOMMANDATIONS" Style="{StaticResource VirgilMicroLabel}" />
                                        <TextBlock x:Name="ReportRecommendationsText" Text="AUCUN SCAN" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,3,0,8" />
                                        <TextBlock Text="ERREURS" Style="{StaticResource VirgilMicroLabel}" />
                                        <TextBlock x:Name="ReportErrorsText" Text="AUCUNE" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource VirgilHudPanel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="COMMUNICATION VIRGIL"
                                       Style="{StaticResource VirgilHudSectionTitle}"
                                       Margin="0,0,0,12" />
                            <StackPanel x:Name="ActionButtonsPanel"
                                        DockPanel.Dock="Bottom"
                                        Margin="0,12,0,0"
                                        KeyboardNavigation.TabNavigation="Continue">
                                <Rectangle Style="{StaticResource VirgilSeparator}" />
                                <Button x:Name="ChatScanButton"
                                        Content="SCAN COMPLET"
                                        Style="{StaticResource VirgilPrimaryButton}"
                                        AutomationProperties.Name="Scan complet communication"
                                        Click="OpenScanProtocol_Click" />
                                <Button x:Name="LastReportButton"
                                        Content="VOIR LE DERNIER RAPPORT"
                                        Style="{StaticResource VirgilSecondaryButton}"
                                        Margin="0,8,0,0"
                                        AutomationProperties.Name="Voir le dernier rapport"
                                        Click="LastReport_Click" />
                            </StackPanel>
                            <Border Background="{DynamicResource App.SecondaryBackgroundBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="12">
                                <ScrollViewer x:Name="ChatScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <StackPanel x:Name="ChatMessagesPanel" />
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="2" Columns="4">
                    <Border Style="{StaticResource VirgilDataCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="MEMOIRE" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="MemoryValueText" Grid.Row="1" Text="-- %" Style="{StaticResource VirgilHudMetric}" Margin="0,10,0,4" />
                            <TextBlock x:Name="MemoryDetailText" Grid.Row="2" Text="EN ATTENTE" Style="{StaticResource VirgilHudSecondaryText}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource VirgilDataCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="DISQUE SYSTEME" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="DiskValueText" Grid.Row="1" Text="-- %" Style="{StaticResource VirgilHudMetric}" Margin="0,10,0,4" />
                            <TextBlock x:Name="DiskDetailText" Grid.Row="2" Text="EN ATTENTE" Style="{StaticResource VirgilHudSecondaryText}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource VirgilDataCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="NETTOYAGE POTENTIEL" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="CleanupValueText" Grid.Row="1" Text="--" Style="{StaticResource VirgilHudMetric}" Margin="0,10,0,4" />
                            <TextBlock x:Name="CleanupDetailText" Grid.Row="2" Text="NON ANALYSE" Style="{StaticResource VirgilHudSecondaryText}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource VirgilDataCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="PRIORITES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="PriorityValueText" Grid.Row="1" Text="0" Style="{StaticResource VirgilHudMetric}" Margin="0,10,0,4" />
                            <TextBlock x:Name="PriorityDetailText" Grid.Row="2" Text="AUCUN SCAN" Style="{StaticResource VirgilHudSecondaryText}" />
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="ScanProtocolOverlay"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    Width="580"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl Width="72"
                                                Height="72"
                                                IsHitTestVisible="False"
                                                AutomationProperties.Name="Mini noyau Virgil" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VIRGIL" Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock Text="SELECTION DU PROTOCOLE"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Selectionnez le niveau d'analyse. Aucune modification ne sera effectuee."
                               Style="{StaticResource VirgilHudSecondaryText}"
                               Margin="0,18,0,20" />
                    <StackPanel x:Name="PopupActionsPanel"
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                KeyboardNavigation.TabNavigation="Continue">
                        <Button x:Name="QuickScanButton"
                                Content="SCAN RAPIDE"
                                Style="{StaticResource VirgilPrimaryButton}"
                                AutomationProperties.Name="Scan rapide"
                                Click="RunQuickScan_Click" />
                        <Button x:Name="DeepScanButton"
                                Content="ANALYSE APPROFONDIE"
                                Style="{StaticResource VirgilPrimaryButton}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Analyse approfondie"
                                Click="RunDeepScan_Click" />
                        <Button x:Name="CancelProtocolButton"
                                Content="ANNULER"
                                Style="{StaticResource VirgilSecondaryButton}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Annuler le protocole"
                                Click="CloseScanProtocol_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ReportOverlay"
              Panel.ZIndex="30"
              Visibility="Collapsed"
              Background="#CC06090D"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource VirgilOverlayCard}"
                    Width="760"
                    MaxWidth="900"
                    MaxHeight="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:VirgilCoreControl Width="72"
                                                Height="72"
                                                IsHitTestVisible="False"
                                                AutomationProperties.Name="Mini noyau Virgil rapport" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VIRGIL" Style="{StaticResource VirgilHudSectionTitle}" />
                        <TextBlock Text="DERNIER RAPPORT"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,18,0,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                            <TextBlock x:Name="ReportPopupSummaryText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <Rectangle Style="{StaticResource VirgilSeparator}" Margin="0,12,0,12" />
                            <TextBlock x:Name="ReportPopupDetailsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap" />
                            <Rectangle Style="{StaticResource VirgilSeparator}" Margin="0,12,0,12" />
                            <TextBlock Text="RECOMMANDATIONS" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ReportPopupRecommendationsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="ERREURS PARTIELLES" Style="{StaticResource VirgilMicroLabel}" />
                            <TextBlock x:Name="ReportPopupErrorsText"
                                       Style="{StaticResource VirgilHudSecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="CloseReportButton"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Content="FERMER"
                            Style="{StaticResource VirgilSecondaryButton}"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Fermer le rapport"
                            Click="CloseReport_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
