<Window x:Class="Virgil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virgil 2.0"
        Width="1100"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource App.BackgroundBrush}"
        Foreground="{DynamicResource App.TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource VirgilHudCard}"
                Effect="{StaticResource VirgilAccentGlow}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="VIRGIL 2.0" Style="{StaticResource VirgilHudTitle}" />
                    <TextBlock Text="Assistant PC local - diagnostic, surveillance, maintenance" Style="{StaticResource VirgilHudSecondaryText}" Margin="0,6,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           Text="Système prêt"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.AccentBrush}"
                           FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="2">
                <Border Style="{StaticResource VirgilHudCard}">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource VirgilHudTitle}" />
                        <TextBlock x:Name="RamMetricText" Text="-- %" Style="{StaticResource VirgilHudMetric}" Margin="0,10,0,0" />
                        <TextBlock x:Name="RamDetailText" Text="En attente d'analyse" Style="{StaticResource VirgilHudSecondaryText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource VirgilHudCard}">
                    <StackPanel>
                        <TextBlock Text="DISQUE" Style="{StaticResource VirgilHudTitle}" />
                        <TextBlock x:Name="DiskMetricText" Text="-- %" Style="{StaticResource VirgilHudMetric}" Margin="0,10,0,0" />
                        <TextBlock x:Name="DiskDetailText" Text="En attente d'analyse" Style="{StaticResource VirgilHudSecondaryText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource VirgilHudCard}">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTIC" Style="{StaticResource VirgilHudTitle}" />
                        <TextBlock x:Name="OverallText" Text="Non lancé" Style="{StaticResource VirgilHudMetric}" FontSize="22" Margin="0,10,0,0" />
                        <TextBlock Text="Analyse locale, sans action automatique." Style="{StaticResource VirgilHudSecondaryText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource VirgilHudCard}">
                    <StackPanel>
                        <TextBlock Text="NETTOYAGE" Style="{StaticResource VirgilHudTitle}" />
                        <TextBlock x:Name="CleanupMetricText" Text="--" Style="{StaticResource VirgilHudMetric}" Margin="0,10,0,0" />
                        <TextBlock x:Name="CleanupDetailText" Text="Prévisualisation uniquement" Style="{StaticResource VirgilHudSecondaryText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Column="1" Style="{StaticResource VirgilHudCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="JOURNAL VIRGIL" Style="{StaticResource VirgilHudTitle}" Margin="0,0,0,12" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText"
                                   Text="[VIRGIL] En attente d'ordre utilisateur.\n"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Diagnostic express" Style="{StaticResource VirgilPrimaryButton}" Margin="0,0,10,0" Click="RunDiagnostic_Click" />
            <Button Content="Prévisualiser nettoyage" Style="{StaticResource VirgilPrimaryButton}" Click="PreviewCleanup_Click" />
        </StackPanel>
    </Grid>
</Window>
