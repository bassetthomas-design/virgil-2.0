<UserControl x:Class="Virgil.App.Controls.VirgilCoreControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <!-- Géométrie du grand visage du dessin validé le 5/11, ramenée à 340 DIP. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="340" Height="340">
            <Ellipse Width="326.4" Height="326.4">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#c9d1d9" Offset="0"/>
                        <GradientStop Color="#5b6570" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="285.6" Height="285.6" Stroke="#59000000" StrokeThickness="3.4">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#2b3440" Offset="0"/>
                        <GradientStop Color="#11161c" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path x:Name="Eyes" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>
