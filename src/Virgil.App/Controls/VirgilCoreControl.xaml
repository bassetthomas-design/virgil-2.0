<UserControl x:Class="Virgil.App.Controls.VirgilCoreControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Viewbox Stretch="Uniform">
        <Grid Width="260" Height="260" RenderTransformOrigin="0.5,0.5">
            <Ellipse x:Name="OuterHalo"
                     Width="246"
                     Height="246"
                     Fill="#22FF7A00"
                     Opacity="0.2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="AmbientWave"
                     Width="84"
                     Height="84"
                     Stroke="{DynamicResource App.AccentLightBrush}"
                     StrokeThickness="2"
                     Opacity="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="AmbientWaveScale" ScaleX="0.42" ScaleY="0.42" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="OuterGuideRing"
                     Width="214"
                     Height="214"
                     Stroke="{DynamicResource App.BorderBrush}"
                     StrokeThickness="1"
                     StrokeDashArray="5 9"
                     Opacity="0.66"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="OuterGuideRingRotate" Angle="0" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="InnerGuideRing"
                     Width="178"
                     Height="178"
                     Stroke="{DynamicResource App.BorderActiveBrush}"
                     StrokeThickness="1.2"
                     StrokeDashArray="18 12"
                     Opacity="0.48"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="InnerGuideRingRotate" Angle="0" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Grid x:Name="OuterMotionAssembly"
                  Opacity="0.72"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="OuterMotionAssemblyRotate" Angle="0" />
                        <RotateTransform x:Name="OuterMotionAssemblyKickRotate" Angle="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Path Data="M 44,88 A 102,102 0 0 1 148,31"
                      Stroke="{DynamicResource App.AccentSoftBrush}"
                      StrokeThickness="2.1"
                      Opacity="0.76"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Path Data="M 210,90 A 102,102 0 0 1 214,162"
                      Stroke="{DynamicResource App.AccentBrush}"
                      StrokeThickness="1.8"
                      Opacity="0.68"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Line X1="188"
                      Y1="72"
                      X2="203"
                      Y2="78"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      StrokeThickness="1.4"
                      Opacity="0.58"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Ellipse x:Name="OuterOrbitalTracer"
                         Width="5"
                         Height="5"
                         Fill="{DynamicResource App.AccentLightBrush}"
                         Opacity="0.72"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="178,31,0,0" />
            </Grid>

            <Grid x:Name="InnerMotionAssembly"
                  Opacity="0.54"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="InnerMotionAssemblyRotate" Angle="0" />
                        <RotateTransform x:Name="InnerMotionAssemblyKickRotate" Angle="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Path Data="M 82,99 A 67,67 0 0 1 143,66"
                      Stroke="{DynamicResource App.BorderActiveBrush}"
                      StrokeThickness="1.55"
                      Opacity="0.66"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Path Data="M 187,126 A 67,67 0 0 1 158,184"
                      Stroke="{DynamicResource App.AccentSoftBrush}"
                      StrokeThickness="1.35"
                      Opacity="0.48"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Ellipse Width="3"
                         Height="3"
                         Fill="{DynamicResource App.AccentLightBrush}"
                         Opacity="0.34"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                         Margin="163,73,0,0" />
            </Grid>

            <Grid x:Name="SegmentRing" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="SegmentRingRotate" Angle="0" />
                </Grid.RenderTransform>
                <Path x:Name="SegmentA"
                      Data="M 130,18 A 112,112 0 0 1 228,76"
                      Stroke="{DynamicResource App.AccentBrush}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Path x:Name="SegmentB"
                      Data="M 242,130 A 112,112 0 0 1 186,228"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Path x:Name="SegmentC"
                      Data="M 130,242 A 112,112 0 0 1 32,184"
                      Stroke="{DynamicResource App.AccentBrush}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Path x:Name="SegmentD"
                      Data="M 18,130 A 112,112 0 0 1 74,32"
                      Stroke="{DynamicResource App.AccentSoftBrush}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
            </Grid>

            <Grid x:Name="AmbientSegments" Opacity="0">
                <Path x:Name="AmbientSegmentA"
                      Data="M 130,18 A 112,112 0 0 1 228,76"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      StrokeThickness="2.4"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Path x:Name="AmbientSegmentB"
                      Data="M 242,130 A 112,112 0 0 1 186,228"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      StrokeThickness="2.4"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
                <Path x:Name="AmbientSegmentC"
                      Data="M 130,242 A 112,112 0 0 1 32,184"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      StrokeThickness="2.4"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
            </Grid>

            <Grid x:Name="TechnicalMarks" Opacity="0.68">
                <Grid x:Name="VerticalMarks">
                    <Line X1="130" Y1="0" X2="130" Y2="24" Stroke="{DynamicResource App.AccentBrush}" StrokeThickness="1" />
                    <Line X1="130" Y1="236" X2="130" Y2="260" Stroke="{DynamicResource App.AccentBrush}" StrokeThickness="1" />
                </Grid>
                <Grid x:Name="HorizontalMarks">
                    <Line X1="0" Y1="130" X2="24" Y2="130" Stroke="{DynamicResource App.AccentBrush}" StrokeThickness="1" />
                    <Line X1="236" Y1="130" X2="260" Y2="130" Stroke="{DynamicResource App.AccentBrush}" StrokeThickness="1" />
                </Grid>
                <Grid x:Name="CornerMarks">
                    <Path Data="M 50,50 L 70,50 M 50,50 L 50,70"
                          Stroke="{DynamicResource App.BorderActiveBrush}"
                          StrokeThickness="1" />
                    <Path Data="M 210,50 L 190,50 M 210,50 L 210,70"
                          Stroke="{DynamicResource App.BorderActiveBrush}"
                          StrokeThickness="1" />
                    <Path Data="M 50,210 L 70,210 M 50,210 L 50,190"
                          Stroke="{DynamicResource App.BorderActiveBrush}"
                          StrokeThickness="1" />
                    <Path Data="M 210,210 L 190,210 M 210,210 L 210,190"
                          Stroke="{DynamicResource App.BorderActiveBrush}"
                          StrokeThickness="1" />
                </Grid>
            </Grid>

            <Grid x:Name="DataSweepAssembly"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="DataSweepAssemblyRotate" Angle="0" />
                </Grid.RenderTransform>
                <Rectangle Width="110"
                           Height="1.2"
                           Fill="{DynamicResource App.AccentLightBrush}"
                           Opacity="0.62"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="DataSweepLineTransform" X="-18" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Path Data="M 64,80 A 78,78 0 0 1 182,60"
                      Stroke="{DynamicResource App.AccentSoftBrush}"
                      StrokeThickness="1.1"
                      Opacity="0.5"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />
            </Grid>

            <Grid x:Name="InnerFragments" RenderTransformOrigin="0.5,0.5">
                <Path x:Name="FragmentTop"
                      Data="M 130,58 L 150,96 L 130,88 L 110,96 Z"
                      Stroke="{DynamicResource App.AccentBrush}"
                      Fill="#10FF7A00"
                      StrokeThickness="1.2"
                      Opacity="0.68"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="FragmentTopTransform" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="FragmentRight"
                      Data="M 202,130 L 164,150 L 172,130 L 164,110 Z"
                      Stroke="{DynamicResource App.AccentBrush}"
                      Fill="#10FF7A00"
                      StrokeThickness="1.2"
                      Opacity="0.62"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="FragmentRightTransform" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="FragmentBottom"
                      Data="M 130,202 L 110,164 L 130,172 L 150,164 Z"
                      Stroke="{DynamicResource App.AccentBrush}"
                      Fill="#10FF7A00"
                      StrokeThickness="1.2"
                      Opacity="0.58"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="FragmentBottomTransform" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="FragmentLeft"
                      Data="M 58,130 L 96,110 L 88,130 L 96,150 Z"
                      Stroke="{DynamicResource App.AccentBrush}"
                      Fill="#10FF7A00"
                      StrokeThickness="1.2"
                      Opacity="0.64"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="FragmentLeftTransform" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <Grid x:Name="CommunicationFragments" Opacity="0">
                <Path x:Name="CommunicationFragmentTop"
                      Data="M 130,58 L 150,96 L 130,88 L 110,96 Z"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      Fill="#24FF9A2E"
                      StrokeThickness="1.4">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="CommunicationTopTransform" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="CommunicationFragmentRight"
                      Data="M 202,130 L 164,150 L 172,130 L 164,110 Z"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      Fill="#24FF9A2E"
                      StrokeThickness="1.4">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="CommunicationRightTransform" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="CommunicationFragmentBottom"
                      Data="M 130,202 L 110,164 L 130,172 L 150,164 Z"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      Fill="#24FF9A2E"
                      StrokeThickness="1.4">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="CommunicationBottomTransform" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="CommunicationFragmentLeft"
                      Data="M 58,130 L 96,110 L 88,130 L 96,150 Z"
                      Stroke="{DynamicResource App.AccentLightBrush}"
                      Fill="#24FF9A2E"
                      StrokeThickness="1.4">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="CommunicationLeftTransform" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <Rectangle x:Name="ScanLine"
                       Width="156"
                       Height="2"
                       Fill="{DynamicResource App.AccentLightBrush}"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ScanLineTransform" Y="-54" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <Ellipse Width="72"
                     Height="72"
                     Stroke="{DynamicResource App.BorderBrush}"
                     StrokeThickness="1"
                     Fill="{DynamicResource App.SecondaryBackgroundBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            <Ellipse x:Name="CenterGlow"
                     Width="44"
                     Height="44"
                     Fill="{DynamicResource App.AccentBrush}"
                     Opacity="0.34"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="CenterGlowScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="CenterDot"
                     Width="18"
                     Height="18"
                     Fill="{DynamicResource App.AccentLightBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            <Ellipse x:Name="CommunicationFlash"
                     Width="58"
                     Height="58"
                     Fill="{DynamicResource App.AccentLightBrush}"
                     Opacity="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="CommunicationFlashScale" ScaleX="0.62" ScaleY="0.62" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="CommunicationWave"
                     Width="92"
                     Height="92"
                     Stroke="{DynamicResource App.AccentLightBrush}"
                     StrokeThickness="2"
                     Opacity="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="CommunicationWaveScale" ScaleX="0.42" ScaleY="0.42" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="StatusFlash"
                     Width="230"
                     Height="230"
                     Stroke="{DynamicResource App.AccentLightBrush}"
                     StrokeThickness="2"
                     Opacity="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="StatusFlashScale" ScaleX="0.82" ScaleY="0.82" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
    </Viewbox>
</UserControl>
