<UserControl x:Class="Virgil.App.Controls.VirgilCoreControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="72"
             MinHeight="72"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Storyboard x:Key="IdleStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Halo"
                             Storyboard.TargetProperty="Opacity"
                             From="0.22"
                             To="0.5"
                             Duration="0:0:1.9"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="CoreScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.98"
                             To="1.025"
                             Duration="0:0:1.9"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="CoreScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.98"
                             To="1.025"
                             Duration="0:0:1.9"
                             AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="ScanningStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CoreRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0"
                             To="360"
                             Duration="0:0:4.2" />
            <DoubleAnimation Storyboard.TargetName="ScanLine"
                             Storyboard.TargetProperty="Opacity"
                             From="0.15"
                             To="0.9"
                             Duration="0:0:0.75"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="ScanLineTranslate"
                             Storyboard.TargetProperty="Y"
                             From="-40"
                             To="40"
                             Duration="0:0:1.5"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SegmentNorth"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2"
                             To="1"
                             Duration="0:0:0.55"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SegmentEast"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25"
                             To="1"
                             BeginTime="0:0:0.18"
                             Duration="0:0:0.55"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SegmentSouth"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2"
                             To="1"
                             BeginTime="0:0:0.36"
                             Duration="0:0:0.55"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SegmentWest"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25"
                             To="1"
                             BeginTime="0:0:0.54"
                             Duration="0:0:0.55"
                             AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="CommunicatingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CenterCore"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7"
                             To="1"
                             Duration="0:0:0.38"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="WaveRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="0.65"
                             Duration="0:0:0.7"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="WaveScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.72"
                             To="1.18"
                             Duration="0:0:0.7"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="WaveScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.72"
                             To="1.18"
                             Duration="0:0:0.7"
                             AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="WarningStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Halo"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35"
                             To="0.78"
                             Duration="0:0:0.52"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="CoreScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1"
                             To="1.055"
                             Duration="0:0:0.52"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="CoreScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1"
                             To="1.055"
                             Duration="0:0:0.52"
                             AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="SensitiveActionStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LockGlyph"
                             Storyboard.TargetProperty="Opacity"
                             From="0.28"
                             To="0.88"
                             Duration="0:0:0.8"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="CoreRotate"
                             Storyboard.TargetProperty="Angle"
                             From="-8"
                             To="8"
                             Duration="0:0:1.4"
                             AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="SuccessStoryboard">
            <DoubleAnimation Storyboard.TargetName="SuccessFlash"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="0.82"
                             Duration="0:0:0.22"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="CoreScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1"
                             To="1.08"
                             Duration="0:0:0.22"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="CoreScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1"
                             To="1.08"
                             Duration="0:0:0.22"
                             AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="ErrorStoryboard">
            <DoubleAnimation Storyboard.TargetName="ErrorFlash"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="0.78"
                             Duration="0:0:0.16"
                             AutoReverse="True"
                             RepeatBehavior="2x" />
        </Storyboard>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="240" Height="240" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CoreScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Ellipse x:Name="Halo"
                     Width="202"
                     Height="202"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#22FF8A00"
                     Opacity="0.35">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="26"
                                      Color="#FF8A00"
                                      Opacity="0.55"
                                      ShadowDepth="0" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="WaveRing"
                     Width="156"
                     Height="156"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#FFFFB14A"
                     StrokeThickness="2"
                     StrokeDashArray="3 5"
                     Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="WaveScale" ScaleX="0.72" ScaleY="0.72" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Canvas Width="240"
                    Height="240"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="CoreRotate" Angle="0" />
                </Canvas.RenderTransform>

                <Polygon x:Name="OuterFrame"
                         Points="120,16 194,48 224,120 194,192 120,224 46,192 16,120 46,48"
                         Fill="#08000000"
                         Stroke="#FFFF8A00"
                         StrokeThickness="2.4"
                         Opacity="0.92" />

                <Polygon x:Name="InnerFrame"
                         Points="120,48 170,70 192,120 170,170 120,192 70,170 48,120 70,70"
                         Fill="#141B1210"
                         Stroke="#99FFB14A"
                         StrokeThickness="1.6"
                         Opacity="0.9" />

                <Path x:Name="SegmentNorth"
                      Data="M108,30 L132,30 L138,61 L102,61 Z"
                      Fill="#66FF8A00"
                      Stroke="#FFFFB14A"
                      StrokeThickness="1.2" />
                <Path x:Name="SegmentNorthEast"
                      Data="M164,48 L186,70 L174,94 L146,67 Z"
                      Fill="#55FF8A00"
                      Stroke="#CCFFB14A"
                      StrokeThickness="1.2"
                      Opacity="0.78" />
                <Path x:Name="SegmentEast"
                      Data="M179,108 L210,108 L210,132 L179,132 Z"
                      Fill="#66FF8A00"
                      Stroke="#FFFFB14A"
                      StrokeThickness="1.2" />
                <Path x:Name="SegmentSouthEast"
                      Data="M174,146 L186,170 L164,192 L146,173 Z"
                      Fill="#55FF8A00"
                      Stroke="#CCFFB14A"
                      StrokeThickness="1.2"
                      Opacity="0.78" />
                <Path x:Name="SegmentSouth"
                      Data="M102,179 L138,179 L132,210 L108,210 Z"
                      Fill="#66FF8A00"
                      Stroke="#FFFFB14A"
                      StrokeThickness="1.2" />
                <Path x:Name="SegmentSouthWest"
                      Data="M66,146 L94,173 L76,192 L54,170 Z"
                      Fill="#55FF8A00"
                      Stroke="#CCFFB14A"
                      StrokeThickness="1.2"
                      Opacity="0.78" />
                <Path x:Name="SegmentWest"
                      Data="M30,108 L61,108 L61,132 L30,132 Z"
                      Fill="#66FF8A00"
                      Stroke="#FFFFB14A"
                      StrokeThickness="1.2" />
                <Path x:Name="SegmentNorthWest"
                      Data="M76,48 L94,67 L66,94 L54,70 Z"
                      Fill="#55FF8A00"
                      Stroke="#CCFFB14A"
                      StrokeThickness="1.2"
                      Opacity="0.78" />

                <Path x:Name="ScanLine"
                      Data="M42,120 L198,120"
                      Stroke="#FFFFD18A"
                      StrokeThickness="2"
                      StrokeDashArray="4 7"
                      Opacity="0">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ScanLineTranslate" Y="0" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>

            <Ellipse x:Name="CenterCore"
                     Width="54"
                     Height="54"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#FFFF8A00"
                     Stroke="#FFFFD18A"
                     StrokeThickness="2"
                     Opacity="0.86" />

            <Ellipse Width="22"
                     Height="22"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#FF05070A"
                     Stroke="#FFFFB14A"
                     StrokeThickness="1.5"
                     Opacity="0.98" />

            <Grid x:Name="LockGlyph"
                  Width="78"
                  Height="78"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="0">
                <Path Data="M24,36 L24,30 C24,18 54,18 54,30 L54,36"
                      Stroke="#FFFF5C2E"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Fill="Transparent" />
                <Path Data="M18,36 L60,36 L60,62 L18,62 Z"
                      Stroke="#FFFF5C2E"
                      StrokeThickness="3"
                      Fill="#22000000" />
            </Grid>

            <Ellipse x:Name="SuccessFlash"
                     Width="190"
                     Height="190"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#44FFD36A"
                     Opacity="0" />

            <Ellipse x:Name="ErrorFlash"
                     Width="194"
                     Height="194"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#44FF4D2E"
                     Opacity="0" />

            <TextBlock x:Name="StateLabel"
                       Text="REPOS"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,12"
                       Foreground="#FFFFB14A"
                       FontFamily="Consolas"
                       FontSize="14"
                       FontWeight="SemiBold" />
        </Grid>
    </Viewbox>
</UserControl>
