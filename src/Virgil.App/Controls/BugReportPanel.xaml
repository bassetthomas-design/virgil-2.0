<UserControl x:Class="Virgil.App.Controls.BugReportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ErrorVisibility" />
    </UserControl.Resources>
    <StackPanel Margin="0,6,0,0">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Content="Signaler un problème" Style="{StaticResource VirgilSecondaryButton}"
                    Command="{Binding OpenCommand}" AutomationProperties.Name="Signaler un problème"
                    AutomationProperties.AutomationId="BugReportButton" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource VirgilHudSecondaryText}"
                       Text="Ouvre une page GitHub préremplie dans votre navigateur. Rien n'est envoyé sans vous." />
        </Grid>
        <TextBlock Text="{Binding ErrorText}" Margin="0,6,0,4" TextWrapping="Wrap"
                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                   Visibility="{Binding HasError, Converter={StaticResource ErrorVisibility}}" />
        <TextBox Text="{Binding FailedUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 Foreground="{DynamicResource App.TextPrimaryBrush}" Background="{DynamicResource App.BackgroundBrush}"
                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Lien du signalement" AutomationProperties.AutomationId="BugReportUrlText"
                 Visibility="{Binding HasError, Converter={StaticResource ErrorVisibility}}" />
    </StackPanel>
</UserControl>
