<UserControl x:Class="Virgil.App.Controls.OperationProgressPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="0,8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel>
   <TextBlock Text="{Binding Step}" Foreground="White" TextWrapping="Wrap"/>
   <ProgressBar Height="6" Margin="0,6" Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"/>
   <TextBlock Text="{Binding Timing}" Foreground="White"/>
  </StackPanel>
  <Button Grid.Column="1" Content="Annuler" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" Margin="12,0,0,0" Padding="12,6"/>
 </Grid>
</UserControl>
